# Copy to .env.production.local on the VPS before `npm run build`.
# NEXT_PUBLIC_* values are baked in at build time — rebuild after changing them.

NEXT_PUBLIC_STRAPI_URL=https://api.dgportal.cloud
NEXT_PUBLIC_APP_URL=https://app.dgportal.cloud
STRAPI_URL=http://127.0.0.1:1337

# Optional: server-side Strapi API token (not exposed to browser)
# STRAPI_API_TOKEN=
