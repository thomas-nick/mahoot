{
  "kind": "collectionType",
  "collectionName": "course_layouts",
  "info": {
    "singularName": "course-layout",
    "pluralName": "course-layouts",
    "displayName": "Course Layout",
    "description": "A named layout (tees + pin set) for a Course. One Course has many Layouts."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "externalId": {
      "type": "string",
      "required": true,
      "unique": true,
      "pluginOptions": {
        "content-manager": {
          "description": "Stable slug, e.g. `idlewild__main-24`. Used to dedupe on import."
        }
      }
    },
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "content-manager": {
          "description": "Display name as players know it, e.g. `Main 24`, `Short 18`."
        }
      }
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "required": true,
      "inversedBy": "courseLayouts"
    },
    "holeCount": {
      "type": "integer",
      "required": true,
      "min": 1,
      "max": 36
    },
    "parTotal": {
      "type": "integer",
      "required": true
    },
    "feetTotal": {
      "type": "integer",
      "min": 0
    },
    "holes": {
      "type": "component",
      "repeatable": true,
      "component": "round.layout-hole",
      "required": true
    },
    "source": {
      "type": "enumeration",
      "enum": [
        "udisc",
        "pdga",
        "manual",
        "submission"
      ],
      "default": "manual"
    },
    "notes": {
      "type": "text"
    },
    "rounds": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::round.round",
      "mappedBy": "layout"
    }
  }
}
