{
  "kind": "collectionType",
  "collectionName": "disc_variants",
  "info": {
    "singularName": "disc-variant",
    "pluralName": "disc-variants",
    "displayName": "Disc Variant"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "externalId": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "displayName": {
      "type": "string",
      "required": true
    },
    "mold": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::disc-mold.disc-mold",
      "required": true
    },
    "plastic": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::plastic-type.plastic-type",
      "required": true
    },
    "speed": {
      "type": "decimal"
    },
    "glide": {
      "type": "decimal"
    },
    "turn": {
      "type": "decimal"
    },
    "fade": {
      "type": "decimal"
    },
    "stability": {
      "type": "string"
    },
    "weightMin": {
      "type": "decimal"
    },
    "weightMax": {
      "type": "decimal"
    },
    "link": {
      "type": "string"
    },
    "imageUrl": {
      "type": "string"
    },
    "notes": {
      "type": "text"
    },
    "slug": {
      "type": "string"
    },
    "ratingAverageOverall": {
      "type": "decimal"
    },
    "ratingCount": {
      "type": "integer"
    },
    "ratingBayesScore": {
      "type": "decimal"
    },
    "releaseType": {
      "type": "enumeration",
      "enum": ["stock", "limited-edition", "tour-series", "money-run", "tournament-run"],
      "default": "stock"
    },
    "productionStatus": {
      "type": "enumeration",
      "enum": ["in-production", "oop"],
      "default": "in-production"
    },
    "runName": {
      "type": "string"
    },
    "runYear": {
      "type": "integer",
      "min": 1900,
      "max": 2100
    },
    "collectorValue": {
      "type": "integer",
      "min": 1,
      "max": 10
    },
    "rarity": {
      "type": "integer",
      "min": 1,
      "max": 10
    },
    "soughtAfter": {
      "type": "integer",
      "min": 1,
      "max": 10
    },
    "priceLowUsd": {
      "type": "decimal"
    },
    "priceHighUsd": {
      "type": "decimal"
    },
    "runNotes": {
      "type": "text"
    }
  }
}
