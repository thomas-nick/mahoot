{
  "kind": "collectionType",
  "collectionName": "collector_releases",
  "info": {
    "singularName": "collector-release",
    "pluralName": "collector-releases",
    "displayName": "Collector Release"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "externalId": {
      "type": "string",
      "unique": true
    },
    "discDocumentId": {
      "type": "string",
      "required": true
    },
    "discExternalId": {
      "type": "string"
    },
    "discName": {
      "type": "string"
    },
    "runName": {
      "type": "string",
      "required": true
    },
    "year": {
      "type": "integer",
      "required": true,
      "min": 1900,
      "max": 2100
    },
    "oopStatus": {
      "type": "enumeration",
      "enum": ["in-production", "oop", "limited-run", "tour-series"],
      "default": "in-production"
    },
    "collectorValue": {
      "type": "integer",
      "min": 1,
      "max": 10
    },
    "rarity": {
      "type": "integer",
      "min": 1,
      "max": 10
    },
    "soughtAfter": {
      "type": "integer",
      "min": 1,
      "max": 10
    },
    "priceLowUsd": {
      "type": "decimal"
    },
    "priceHighUsd": {
      "type": "decimal"
    },
    "imageUrl": {
      "type": "string",
      "pluginOptions": {
        "content-manager": {
          "description": "Optional image URL for this collector run (e.g. stamp photo)."
        }
      }
    },
    "notes": {
      "type": "text"
    }
  }
}
